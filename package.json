{
  "name": "byte-craft",
  "version": "1.0.0",
  "description": "Ultra-lightweight, zero-dependency binary and byte buffer manipulation toolkit for TypeScript and JavaScript",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean && tsc --declaration --emitDeclarationOnly",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "example": "tsx examples/packet-protocol.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "binary",
    "buffer",
    "hex",
    "bitwise",
    "bitmask",
    "stream",
    "byte",
    "encoder",
    "crc32",
    "hexdump"
  ],
  "author": "PixelCraftLab <vishalgowdask65@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PixelCraftLab/npm.git"
  },
  "bugs": {
    "url": "https://github.com/PixelCraftLab/npm/issues"
  },
  "homepage": "https://github.com/PixelCraftLab/npm#readme",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
